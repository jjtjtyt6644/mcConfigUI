# Server port (Oracle Cloud backend API daemon runs on 4000)
PORT=4000

# Host platform configuration
NODE_ENV=development

# Allowed Frontend Origins (supports Vercel domain and local dev)
# Example for production: https://aetheris.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app

# Oracle Cloud ARM Resource Thresholds (24GB RAM total, 4 OCPUs)
# We reserve 4GB for Host OS + Docker Engine, allocating up to 20GB for Minecraft instances
HOST_MAX_ALLOCATED_RAM_MB=20480
DEFAULT_SERVER_RAM_MB=2048
DEFAULT_SERVER_CPU_THREADS=1

# Storage Directory for multi-tenant server volumes
STORAGE_ROOT=./data/servers

# Docker Socket (Linux default /var/run/docker.sock, on Windows named pipe: //./pipe/docker_engine)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Inactivity shutdown timer (minutes with 0 players before container shuts down)
INACTIVITY_TIMEOUT_MINUTES=5

# Default RCON configuration generated per server
DEFAULT_RCON_PORT=25575
DEFAULT_RCON_PASSWORD=aetheris_secure_rcon
